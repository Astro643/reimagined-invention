    "postgres": "^4.1.1",
    "remix": "^3.2.0",
    "steel-sdk": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
