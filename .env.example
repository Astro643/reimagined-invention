# Controller — unified Remix app (Render + Upstash Box + Postgres)

# Required
DATABASE_URL=                  # Render Postgres internal connection string (postgres://...)
BETTER_AUTH_SECRET=            # long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=               # public site URL, e.g. https://your-service.onrender.com
UPSTASH_BOX_API_KEY=           # Upstash console → Box → API keys (agent execution + headless Chromium)
GEMINI_API_KEY=                # Google AI Studio key (or GEMINI_API_KEYS / GEMINI_API_KEY_1..4 for rotation)

# Discord toolsets (agent acts on one configured server via the bot token)
DISCORD_TOKEN=                 # bot token used by discord_* tools and $DISCORD_TOKEN inside plan-step shells
DISCORD_GUILD_ID=              # the single Discord server the tools may touch

# Optional
AGENT_API_KEY=                 # bearer key for the bot-facing JSON API (/api/preview, /api/execute, /api/controller/agent/*)
GEMINI_API_KEYS=               # comma-separated keys for quota rotation
GEMINI_API_KEY_1..4=           # extra rotation keys
MODEL_AGENT=                   # override agent model (default gemini-4-hydrogen)
MODEL_DECISION=                # override decision-turn model (default gemini-decision-1)
MODEL_SUPPORT=                 # override support model (default gemini-flash-latest)
PORT=                          # default 5173
NODE_ENV=                      # production for deploys
